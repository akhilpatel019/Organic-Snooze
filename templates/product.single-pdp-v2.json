    "nw_faq_VygLpj": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_hb8tnf": {
          "type": "faq_item",
          "settings": {
            "question": "Is the Snooze Nest firm enough for infant safety?",
            "answer": "<p>Yes. The 2\" coconut coir core gives the firm, flat support recommended for infant sleep, holding its shape without sinking or contouring the way foam can. The design meets infant sleep safety guidelines and is pressure-tested for safety.</p>"
          }
        },
        "faq_item_rnJYwh": {
          "type": "faq_item",
          "settings": {
            "question": "What size cribs does it fit?",
            "answer": "<p>It's 28\" x 52\", the standard U.S. crib size, with a 5\" height, so it fits all standard cribs.</p>"
          }
        },
        "faq_item_rG8phx": {
          "type": "faq_item",
          "settings": {
            "question": "Is it waterproof?",
            "answer": "<p>The mattress itself is made with natural materials, so we recommend using the included organic machine washable protector to help guard against spills, leaks, and everyday messes.&nbsp;</p>"
          }
        },
        "faq_item_qwBaqn": {
          "type": "faq_item",
          "settings": {
            "question": "What’s included in the crib bundle?",
            "answer": "<p>The bundle includes the Snooze Nest Crib Mattress, organic cotton crib sheets, and an organic mattress protector — everything needed to create a cleaner first sleep setup.</p>"
          }
        },
        "faq_item_QbMgNb": {
          "type": "faq_item",
          "settings": {
            "question": "Why use a protector if the mattress is organic?",
            "answer": "<p>Babies are messy. A protector helps keep the mattress cleaner over time while preserving the organic sleep surface parents are trying to create. Machine washable.</p>"
          }
        },
        "faq_item_pV4KRW": {
          "type": "faq_item",
          "settings": {
            "question": "Are the sheets included organic cotton?",
            "answer": "<p>Yes. The crib sheets are made with organic cotton for a soft, breathable surface against your baby’s skin.</p>"
          }
        },
        "faq_item_EkJ8ed": {
          "type": "faq_item",
          "settings": {
            "question": "What makes the Snooze Nest safer than conventional crib mattresses?",
            "answer": "<p>It's OEKO-TEX certified and made in a GOTS/GOLS certified facility. There are no chemical flame retardants, no polyurethane foams, no synthetic adhesives, and no VOCs, and it's pressure-tested for infant safety.</p>"
          }
        }
      },
