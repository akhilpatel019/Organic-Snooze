    "nw_faq_VygLpj": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_hb8tnf": {
          "type": "faq_item",
          "settings": {
            "question": "Is the K-Snooze Dog Bed good for dogs with joint pain?",
            "answer": "<p>Yes. The firm coconut coir core gives orthopedic support that takes pressure off the joints, which can help dogs with arthritis or hip issues. The hemp and wool layers add breathability and comfort for restful, recovery-focused sleep.</p>"
          }
        },
        "faq_item_rnJYwh": {
          "type": "faq_item",
          "settings": {
            "question": "What sizes is it available in?",
            "answer": "<p>There are three sizes available: Small (20\"x26\") for dogs under 10 lbs, Medium (34\"x26\") for dogs under 30 lbs, Large (44\"x34\") for dogs over 30 lbs</p>"
          }
        },
        "faq_item_rG8phx": {
          "type": "faq_item",
          "settings": {
            "question": "Is the cover removable and washable?",
            "answer": "<p>Yes. It comes with a zippable organic cotton cover that's fully removable and machine washable, so it's easy to keep fresh.</p>"
          }
        },
        "faq_item_qwBaqn": {
          "type": "faq_item",
          "settings": {
            "question": "Is it waterproof or water-resistant?",
            "answer": "<p>The cover is water resistant and fully removable via zipper for easy washing.</p>"
          }
        },
        "faq_item_QbMgNb": {
          "type": "faq_item",
          "settings": {
            "question": "What organic materials are used?",
            "answer": "<p>Natural coconut coir, hemp, and wool, finished with an organic cotton cover. The same clean philosophy behind every Ultimate Snooze product, free from synthetic foams, chemical treatments, and artificial materials.</p>"
          }
        },
        "faq_item_pV4KRW": {
          "type": "faq_item",
          "settings": {
            "question": "Why choose an organic dog bed over a conventional one?",
            "answer": "<p>Conventional dog beds often use polyurethane foam, synthetic fibers, and chemical flame retardants. Dogs sleep a lot and stay low to the ground, which makes off-gassing matter more, not less. The K-Snooze uses only natural coconut, hemp, and wool, so your dog rests on clean materials.</p>"
          }
        },
        "faq_item_EkJ8ed": {
          "type": "faq_item",
          "settings": {
            "question": "Does it come with a return policy?",
            "answer": "<p>Yes. It may be returned within 30 days of delivery. Unopened and sealed carries no restocking fee (you pay return shipping). Opened or lightly used carries a 20% restocking fee. Stained or damaged items are not eligible.</p>"
          }
        }
      },
