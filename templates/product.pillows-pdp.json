    "nw_faq_VygLpj": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_hb8tnf": {
          "type": "faq_item",
          "settings": {
            "question": "Can I adjust how thick the pillow is?",
            "answer": "<p>Yes. All Ultimate Snooze pillows are adjustable. You can remove filling to reach a softer, thinner feel, or keep it full for more loft and support.</p>"
          }
        },
        "faq_item_rnJYwh": {
          "type": "faq_item",
          "settings": {
            "question": "What sizes and packs are available?",
            "answer": "<p>Two sizes: Queen (20\" x 30\") at $234.99 and King (20\" x 36\") at $269.99. This pillow is sold individually.</p>"
          }
        },
        "faq_item_rG8phx": {
          "type": "faq_item",
          "settings": {
            "question": "Does it come with anything?",
            "answer": "<p>Yes. Every pillow includes a free machine-washable organic cotton protector.</p>"
          }
        },
        "faq_item_qwBaqn": {
          "type": "faq_item",
          "settings": {
            "question": "Is it good for allergies?",
            "answer": "<p>Yes. The organic wool and latex fills are naturally hypoallergenic and resistant to mold, mildew, and dust mites.</p>"
          }
        },
        "faq_item_QbMgNb": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return a pillow?",
            "answer": "<p>Pillows may be returned within 30 days, provided they're clean and undamaged. Confirm exact return terms at checkout, as personal-care items can have specific conditions.</p>"
          }
        },
        "faq_item_pV4KRW": {
          "type": "faq_item",
          "settings": {
            "question": "How do I wash it?",
            "answer": "<p>Don't machine-wash the pillow itself, as water can damage the natural fibers. Instead, keep the included protector on and machine-wash the protector as needed. To refresh the pillow, air it in direct sunlight.</p>"
          }
        }
      },
