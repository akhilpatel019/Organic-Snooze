    "custom_liquid_z7zdmm": {
      "type": "custom-liquid",
      "name": "JR-Cl-Liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Pillow Flip (Custom Liquid version): paste this whole file into a Custom Liquid block.\n  To change text or colors, edit the assign lines below. Separate benefits with a | character.\n{%- endcomment -%}\n\n{%- liquid\n  assign s_wool_image = nil\n  assign s_latex_image = nil\n  assign s_eyebrow = \"One pillow, two feels\"\n  assign s_heading = \"Flip It to Fit Your Sleep\"\n  assign s_subheading = \"Two certified organic sides. Choose firm support or a softer cradle, then flip whenever your body asks for something different.\"\n  assign s_heading_font = \"Optima, 'Optima nova', Candara, 'Segoe UI', sans-serif\"\n  assign s_body_font = \"'DM Sans', system-ui, sans-serif\"\n  assign s_load_dm_sans = true\n  assign s_use_3d = true\n  assign s_fabric = \"#E8DCC2\"\n  assign s_blend_image = false\n  assign s_wool_stamp = \"Wool side\"\n  assign s_wool_side = \"Side 01\"\n  assign s_wool_chip = \"Firm\"\n  assign s_wool_title = \"Organic Wool\"\n  assign s_wool_text = \"Dense, springy organic wool creates a firmer surface designed to keep your neck in line with your spine. Made for side sleepers who want real support.\"\n  assign s_wool_points = \"Firmer, supportive feel|Helps keep your neck aligned|Naturally regulates temperature|Best for side sleepers\"\n  assign s_wool_step = \"Wool side\"\n  assign s_latex_stamp = \"Latex side\"\n  assign s_latex_side = \"Side 02\"\n  assign s_latex_chip = \"Cradle\"\n  assign s_latex_title = \"Organic Latex\"\n  assign s_latex_text = \"Responsive organic latex gently contours to your head, cradling it without the stuck, sinking feel of foam. Breathable, and it bounces right back.\"\n  assign s_latex_points = \"Softer, contouring feel|Cradles your head|Breathable and responsive|Great for back sleepers\"\n  assign s_latex_step = \"Latex side\"\n  assign s_note = \"Made without synthetic foam, chemical fillers, or fiberglass.\"\n  assign s_scroll_length = 260\n  assign s_bg = \"#F6F1EA\"\n  assign s_text = \"#3A3530\"\n  assign s_muted = \"#857B71\"\n  assign s_accent = \"#C08A5E\"\n  assign s_card = \"#FFFFFF\"\n  assign s_card_alt = \"#9C6B43\"\n  assign s_card_alt_text = \"#FBF6EE\"\n  assign s_card_alt_chip = \"#6F7346\"\n  assign s_badge = \"#8B8E5A\"\n-%}\n\n{%- liquid\n  assign sid = 'pillowflip'\n  assign latex_img = s_latex_image | default: s_wool_image\n  assign wool_pts = s_wool_points | split: '|'\n  assign latex_pts = s_latex_points | split: '|'\n-%}\n\n{%- if s_load_dm_sans -%}\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap\">\n{%- endif -%}\n{%- if s_heading_font_url != blank -%}\n  <style>@font-face { font-family: 'Optima'; src: url('{{ s_heading_font_url }}'); font-weight: 400; font-display: swap; }</style>\n{%- endif -%}\n\n<style>\n  .pf-flip {\n    background: var(--pf-bg);\n    color: var(--pf-text);\n  }\n  .pf-flip *, .pf-flip *::before, .pf-flip *::after { box-sizing: border-box; }\n  .pf-flip__track { position: relative; height: var(--pf-len, 260vh); }\n  .pf-flip__sticky {\n    position: sticky; top: 0;\n    height: 100vh; height: 100svh;\n    display: flex; flex-direction: column; justify-content: center;\n    gap: clamp(18px, 4vh, 44px);\n    padding: clamp(24px, 5vh, 64px) 20px;\n    overflow: hidden;\n  }\n  .pf-flip__head { text-align: center; max-width: 660px; margin: 0 auto; }\n  .pf-flip__eyebrow {\n    font-family: var(--pf-body); font-size: 12px; font-weight: 500;\n    letter-spacing: .2em; text-transform: uppercase;\n    color: var(--pf-accent); margin: 0 0 10px;\n  }\n  .pf-flip__heading {\n    font-family: var(--pf-heading); font-weight: 400;\n    font-size: clamp(28px, 4vw, 44px); line-height: 1.1;\n    margin: 0 0 12px; color: var(--pf-text);\n  }\n  .pf-flip__sub { font-family: var(--pf-body); font-size: 15px; line-height: 1.6; color: var(--pf-muted); margin: 0; }\n\n  .pf-flip__stage {\n    display: grid; grid-template-columns: 1.25fr 1fr; align-items: center;\n    gap: clamp(24px, 5vw, 72px);\n    max-width: 1120px; width: 100%; margin: 0 auto;\n  }\n\n  /* Pillow */\n  .pf-flip__visual {\n    position: relative; perspective: 1400px;\n    aspect-ratio: 3 / 2; display: flex; align-items: center; justify-content: center;\n  }\n  .pf-flip__shadow {\n    position: absolute; bottom: 7%; left: 16%; right: 16%; height: 10%;\n    border-radius: 50%;\n    background: radial-gradient(ellipse at center, rgba(70, 52, 34, .30), rgba(70, 52, 34, 0) 70%);\n    filter: blur(6px); transform-origin: center; will-change: transform, opacity;\n  }\n  .pf-flip__pillow {\n    position: relative; width: 88%; aspect-ratio: 3 / 2;\n    transform-style: preserve-3d; will-change: transform;\n  }\n  .pf-flip__face {\n    position: absolute; inset: 0;\n    backface-visibility: hidden; -webkit-backface-visibility: hidden;\n    display: flex; align-items: center; justify-content: center;\n  }\n  .pf-flip__face--back { transform: rotateX(180deg); }\n  .pf-flip__face img, .pf-flip__face svg { width: 100%; height: 100%; object-fit: contain; display: block; }\n  .pf-flip--blend .pf-flip__face img { mix-blend-mode: multiply; }\n  .pf-flip__three { position: absolute; inset: -14% -8% -6%; opacity: 0; transition: opacity .4s ease; pointer-events: none; }\n  .pf-flip__three canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; }\n  .pf-flip.pf-3d .pf-flip__three { opacity: 1; }\n  .pf-flip.pf-3d .pf-flip__pillow, .pf-flip.pf-3d .pf-flip__shadow { visibility: hidden; }\n  .pf-flip__stamp {\n    position: absolute; bottom: 14%; left: 50%; transform: translateX(-50%);\n    font-family: var(--pf-body); font-size: 11px; font-weight: 600;\n    letter-spacing: .18em; text-transform: uppercase; white-space: nowrap;\n    color: var(--pf-text); background: rgba(255, 255, 255, .82);\n    padding: 7px 14px; border-radius: 999px;\n    box-shadow: 0 6px 18px -8px rgba(58, 45, 30, .35);\n  }\n\n  /* Cards */\n  .pf-flip__cards { perspective: 1600px; }\n  .pf-flip__cardflip { display: grid; transform-style: preserve-3d; will-change: transform; }\n  .pf-flip__card {\n    grid-area: 1 / 1;\n    background: var(--pf-card); border-radius: 14px;\n    border: 1px solid rgba(58, 53, 48, .07);\n    box-shadow: 0 24px 50px -28px rgba(58, 45, 30, .35);\n    padding: clamp(22px, 3vw, 36px);\n    backface-visibility: hidden; -webkit-backface-visibility: hidden;\n    pointer-events: none;\n  }\n  .pf-flip__card.is-active { pointer-events: auto; }\n  .pf-flip__card--back {\n    transform: rotateX(180deg);\n    background: var(--pf-card-alt); border-color: rgba(255, 255, 255, .06);\n    box-shadow: 0 28px 60px -26px rgba(70, 45, 20, .5);\n  }\n  .pf-flip__card--back .pf-flip__side { color: var(--pf-card-alt-text); opacity: .6; }\n  .pf-flip__card--back .pf-flip__chip { background: var(--pf-card-alt-chip); }\n  .pf-flip__card--back .pf-flip__check { background: rgba(255, 255, 255, .22); }\n  .pf-flip__card--back .pf-flip__title { color: var(--pf-card-alt-text); }\n  .pf-flip__card--back .pf-flip__text { color: var(--pf-card-alt-text); opacity: .86; }\n  .pf-flip__card--back .pf-flip__list { border-top-color: rgba(255, 255, 255, .12); }\n  .pf-flip__card--back .pf-flip__list li { color: var(--pf-card-alt-text); }\n  .pf-flip__meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n  .pf-flip__side {\n    font-family: var(--pf-body); font-size: 11px; letter-spacing: .18em;\n    text-transform: uppercase; color: var(--pf-muted);\n  }\n  .pf-flip__chip {\n    font-family: var(--pf-body); font-size: 11px; font-weight: 600;\n    letter-spacing: .12em; text-transform: uppercase;\n    background: var(--pf-badge); color: #fff; padding: 5px 10px; border-radius: 4px;\n  }\n  .pf-flip__title {\n    font-family: var(--pf-heading); font-weight: 400;\n    font-size: clamp(26px, 2.6vw, 34px); line-height: 1.15; margin: 0 0 10px; color: var(--pf-text);\n  }\n  .pf-flip__text { font-family: var(--pf-body); font-size: 15px; line-height: 1.65; color: var(--pf-muted); margin: 0 0 18px; }\n  .pf-flip__list { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid rgba(58, 53, 48, .08); display: grid; gap: 10px; }\n  .pf-flip__list li {\n    display: flex; align-items: flex-start; gap: 10px;\n    font-family: var(--pf-body); font-size: 14px; line-height: 1.45; color: var(--pf-text);\n  }\n  .pf-flip__check {\n    flex: none; width: 18px; height: 18px; margin-top: 1px; border-radius: 50%;\n    background: var(--pf-accent); display: inline-flex; align-items: center; justify-content: center;\n  }\n  .pf-flip__note {\n    font-family: var(--pf-body); font-size: 12px; color: var(--pf-muted);\n    text-align: center; margin: 14px 0 0; letter-spacing: .02em;\n  }\n\n  /* Progress */\n  .pf-flip__steps { display: flex; align-items: center; justify-content: center; gap: 14px; }\n  .pf-flip__step {\n    font-family: var(--pf-body); font-size: 12px; font-weight: 500;\n    letter-spacing: .16em; text-transform: uppercase;\n    background: none; border: 0; padding: 6px 2px; cursor: pointer;\n    color: var(--pf-muted); transition: color .3s ease;\n  }\n  .pf-flip__step.is-active { color: var(--pf-text); }\n  .pf-flip__step:focus-visible { outline: 2px solid var(--pf-accent); outline-offset: 3px; border-radius: 2px; }\n  .pf-flip__bar { width: min(200px, 28vw); height: 2px; background: rgba(58, 53, 48, .12); border-radius: 2px; overflow: hidden; }\n  .pf-flip__fill { display: block; height: 100%; background: var(--pf-accent); transform-origin: left; transform: scaleX(0); }\n\n  @media (max-width: 749px) {\n    .pf-flip__sticky { gap: 14px; padding: 20px 16px; }\n    .pf-flip__stage { grid-template-columns: 1fr; gap: 10px; }\n    .pf-flip__visual { width: 100%; max-width: 380px; margin: 0 auto; }\n    .pf-flip__card { padding: 18px 18px 16px; }\n    .pf-flip__text { font-size: 14px; margin-bottom: 12px; }\n    .pf-flip__list { grid-template-columns: 1fr 1fr; gap: 8px 12px; padding-top: 12px; }\n    .pf-flip__list li { font-size: 12.5px; }\n    .pf-flip__list li:last-child:nth-child(odd) { grid-column: 1 / -1; }\n    .pf-flip__note { display: none; }\n  }\n  @media (max-width: 749px) and (max-height: 760px) {\n    .pf-flip__sub { display: none; }\n    .pf-flip__text { display: none; }\n  }\n</style>\n\n<section\n  id=\"PillowFlip-{{ sid }}\"\n  class=\"pf-flip{% if s_blend_image %} pf-flip--blend{% endif %}\"\n  data-use3d=\"{{ s_use_3d }}\"\n  data-fabric=\"{{ s_fabric }}\"\n  data-label-bg=\"{{ s_badge }}\"\n  data-wool-label=\"{{ s_wool_stamp | escape }}\"\n  data-latex-label=\"{{ s_latex_stamp | escape }}\"\n  style=\"--pf-heading: {{ s_heading_font | replace: '\"', \"'\" }}; --pf-body: {{ s_body_font | replace: '\"', \"'\" }}; --pf-bg: {{ s_bg }}; --pf-text: {{ s_text }}; --pf-muted: {{ s_muted }}; --pf-accent: {{ s_accent }}; --pf-card: {{ s_card }}; --pf-badge: {{ s_badge }}; --pf-card-alt: {{ s_card_alt }}; --pf-card-alt-text: {{ s_card_alt_text }}; --pf-card-alt-chip: {{ s_card_alt_chip }}; --pf-len: {{ s_scroll_length }}vh;\"\n>\n  <div class=\"pf-flip__track\" data-track>\n    <div class=\"pf-flip__sticky\">\n      <div class=\"pf-flip__head\">\n        {%- if s_eyebrow != blank -%}<p class=\"pf-flip__eyebrow\">{{ s_eyebrow }}</p>{%- endif -%}\n        {%- if s_heading != blank -%}<h2 class=\"pf-flip__heading\">{{ s_heading }}</h2>{%- endif -%}\n        {%- if s_subheading != blank -%}<p class=\"pf-flip__sub\">{{ s_subheading }}</p>{%- endif -%}\n      </div>\n\n      <div class=\"pf-flip__stage\">\n        <div class=\"pf-flip__visual\" aria-hidden=\"true\">\n          <div class=\"pf-flip__three\" data-three></div>\n          <div class=\"pf-flip__shadow\" data-shadow></div>\n          <div class=\"pf-flip__pillow\" data-pillow>\n            <div class=\"pf-flip__face pf-flip__face--front\">\n              {%- if s_wool_image -%}\n                {{ s_wool_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 600px, 90vw', alt: '' }}\n              {%- else -%}\n                <svg viewBox=\"0 0 600 400\" role=\"presentation\">\n                  <defs>\n                    <radialGradient id=\"pfW-{{ sid }}\" cx=\"48%\" cy=\"40%\" r=\"68%\"><stop offset=\"0\" stop-color=\"#FCF8EF\"/><stop offset=\".7\" stop-color=\"#EEE4D2\"/><stop offset=\"1\" stop-color=\"#D9CBB2\"/></radialGradient>\n                    <pattern id=\"pfWp-{{ sid }}\" width=\"14\" height=\"14\" patternUnits=\"userSpaceOnUse\"><circle cx=\"3\" cy=\"4\" r=\".9\" fill=\"#B9A685\" opacity=\".35\"/><circle cx=\"10\" cy=\"10\" r=\".7\" fill=\"#B09C7B\" opacity=\".3\"/></pattern>\n                  </defs>\n                  <path d=\"M48 70 C180 40 420 40 552 70 C578 160 578 240 552 330 C420 362 180 362 48 330 C22 240 22 160 48 70Z\" fill=\"url(#pfW-{{ sid }})\"/>\n                  <path d=\"M48 70 C180 40 420 40 552 70 C578 160 578 240 552 330 C420 362 180 362 48 330 C22 240 22 160 48 70Z\" fill=\"url(#pfWp-{{ sid }})\"/>\n                  <path d=\"M64 84 C185 58 415 58 536 84 C558 165 558 235 536 316 C415 342 185 342 64 316 C42 235 42 165 64 84Z\" fill=\"none\" stroke=\"#C7B494\" stroke-width=\"1.5\" stroke-dasharray=\"2 6\" opacity=\".7\"/>\n                </svg>\n              {%- endif -%}\n              <span class=\"pf-flip__stamp\">{{ s_wool_stamp }}</span>\n            </div>\n            <div class=\"pf-flip__face pf-flip__face--back\">\n              {%- if latex_img -%}\n                {{ latex_img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 600px, 90vw', alt: '' }}\n              {%- else -%}\n                <svg viewBox=\"0 0 600 400\" role=\"presentation\">\n                  <defs>\n                    <radialGradient id=\"pfL-{{ sid }}\" cx=\"48%\" cy=\"40%\" r=\"68%\"><stop offset=\"0\" stop-color=\"#F9F0DF\"/><stop offset=\".7\" stop-color=\"#E9D8B9\"/><stop offset=\"1\" stop-color=\"#D3BE99\"/></radialGradient>\n                    <pattern id=\"pfLp-{{ sid }}\" width=\"22\" height=\"22\" patternUnits=\"userSpaceOnUse\"><circle cx=\"11\" cy=\"11\" r=\"2.2\" fill=\"#BFA77E\" opacity=\".3\"/></pattern>\n                  </defs>\n                  <path d=\"M48 70 C180 40 420 40 552 70 C578 160 578 240 552 330 C420 362 180 362 48 330 C22 240 22 160 48 70Z\" fill=\"url(#pfL-{{ sid }})\"/>\n                  <path d=\"M48 70 C180 40 420 40 552 70 C578 160 578 240 552 330 C420 362 180 362 48 330 C22 240 22 160 48 70Z\" fill=\"url(#pfLp-{{ sid }})\"/>\n                  <path d=\"M64 84 C185 58 415 58 536 84 C558 165 558 235 536 316 C415 342 185 342 64 316 C42 235 42 165 64 84Z\" fill=\"none\" stroke=\"#C2AA82\" stroke-width=\"1.5\" stroke-dasharray=\"2 6\" opacity=\".7\"/>\n                </svg>\n              {%- endif -%}\n              <span class=\"pf-flip__stamp\">{{ s_latex_stamp }}</span>\n            </div>\n          </div>\n        </div>\n\n        <div>\n          <div class=\"pf-flip__cards\" aria-live=\"polite\">\n           <div class=\"pf-flip__cardflip\" data-cardflip>\n            <article class=\"pf-flip__card is-active\" data-card aria-hidden=\"false\">\n              <div class=\"pf-flip__meta\">\n                <span class=\"pf-flip__side\">{{ s_wool_side }}</span>\n                <span class=\"pf-flip__chip\">{{ s_wool_chip }}</span>\n              </div>\n              <h3 class=\"pf-flip__title\">{{ s_wool_title }}</h3>\n              <p class=\"pf-flip__text\">{{ s_wool_text }}</p>\n              <ul class=\"pf-flip__list\">\n                {%- for pt in wool_pts -%}{%- assign p = pt | strip -%}{%- if p != blank -%}\n                  <li><span class=\"pf-flip__check\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2.5 6.2l2.3 2.3 4.7-5\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>{{ p }}</li>\n                {%- endif -%}{%- endfor -%}\n              </ul>\n            </article>\n            <article class=\"pf-flip__card pf-flip__card--back\" data-card aria-hidden=\"true\">\n              <div class=\"pf-flip__meta\">\n                <span class=\"pf-flip__side\">{{ s_latex_side }}</span>\n                <span class=\"pf-flip__chip\">{{ s_latex_chip }}</span>\n              </div>\n              <h3 class=\"pf-flip__title\">{{ s_latex_title }}</h3>\n              <p class=\"pf-flip__text\">{{ s_latex_text }}</p>\n              <ul class=\"pf-flip__list\">\n                {%- for pt in latex_pts -%}{%- assign p = pt | strip -%}{%- if p != blank -%}\n                  <li><span class=\"pf-flip__check\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2.5 6.2l2.3 2.3 4.7-5\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>{{ p }}</li>\n                {%- endif -%}{%- endfor -%}\n              </ul>\n            </article>\n           </div>\n          </div>\n          {%- if s_note != blank -%}<p class=\"pf-flip__note\">{{ s_note }}</p>{%- endif -%}\n        </div>\n      </div>\n\n      <div class=\"pf-flip__steps\">\n        <button type=\"button\" class=\"pf-flip__step is-active\" data-step=\"0\">{{ s_wool_step }}</button>\n        <span class=\"pf-flip__bar\"><span class=\"pf-flip__fill\" data-fill></span></span>\n        <button type=\"button\" class=\"pf-flip__step\" data-step=\"1\">{{ s_latex_step }}</button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    var root = document.getElementById('PillowFlip-{{ sid }}');\n    if (!root) return;\n    var track = root.querySelector('[data-track]');\n    var pillow = root.querySelector('[data-pillow]');\n    var shadow = root.querySelector('[data-shadow]');\n    var cardFlip = root.querySelector('[data-cardflip]');\n    var fill = root.querySelector('[data-fill]');\n    var cards = root.querySelectorAll('[data-card]');\n    var steps = root.querySelectorAll('[data-step]');\n    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var START = 0.3, END = 0.7, current = 0, ticking = false;\n\n    function clamp(v) { return Math.min(1, Math.max(0, v)); }\n    function ease(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }\n\n    function setSide(idx) {\n      if (idx === current) return;\n      current = idx;\n      cards.forEach(function (c, i) {\n        c.classList.toggle('is-active', i === idx);\n        c.setAttribute('aria-hidden', i === idx ? 'false' : 'true');\n      });\n      steps.forEach(function (s, i) { s.classList.toggle('is-active', i === idx); });\n    }\n\n    function update() {\n      ticking = false;\n      var total = track.offsetHeight - window.innerHeight;\n      var p = total > 0 ? clamp(-track.getBoundingClientRect().top / total) : 0;\n      var t = clamp((p - START) / (END - START));\n      var lift = Math.sin(Math.PI * t);\n      if (reduce) {\n        pillow.style.transform = 'rotateX(' + (t >= 0.5 ? 180 : 0) + 'deg)';\n      } else {\n        pillow.style.transform = 'translateY(' + (-lift * 9) + '%) rotateX(' + (ease(t) * 180) + 'deg) scale(' + (1 + lift * 0.04) + ')';\n        shadow.style.transform = 'scale(' + (1 - lift * 0.35) + ')';\n        shadow.style.opacity = 1 - lift * 0.55;\n      }\n      var cardTurn = reduce ? (t >= 0.5 ? 180 : 0) : ease(t) * 180;\n      cardFlip.style.transform = 'rotateX(' + cardTurn + 'deg) scale(' + (reduce ? 1 : 1 - lift * 0.05) + ')';\n      fill.style.transform = 'scaleX(' + p + ')';\n      root._pf = { t: t, p: p };\n      root.dispatchEvent(new CustomEvent('pf:progress', { detail: root._pf }));\n      setSide(t >= 0.5 ? 1 : 0);\n    }\n\n    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }\n    window.addEventListener('scroll', onScroll, { passive: true });\n    window.addEventListener('resize', onScroll);\n\n    steps.forEach(function (btn, i) {\n      btn.addEventListener('click', function () {\n        var total = track.offsetHeight - window.innerHeight;\n        var top = track.getBoundingClientRect().top + window.scrollY;\n        window.scrollTo({ top: top + total * (i === 0 ? 0.12 : 0.88), behavior: reduce ? 'auto' : 'smooth' });\n      });\n    });\n\n    update();\n  })();\n</script>\n\n<script type=\"module\">\n  const root = document.getElementById('PillowFlip-{{ sid }}');\n  const THREE_SRC = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';\n  if (root && root.dataset.use3d === 'true') {\n    Promise.all([import(THREE_SRC), document.fonts ? document.fonts.ready : null]).then(([THREE]) => { try { pillow3D(THREE, root); } catch (e) { console.warn('Pillow 3D fallback', e); } }).catch(() => {});\n  }\n\n  function pillow3D(THREE, root) {\n    const host = root.querySelector('[data-three]');\n    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const W = 3, H = 2, T = 0.5;                // pillow width, depth, half thickness\n    const fabric = new THREE.Color(root.dataset.fabric || '#E8DCC2');\n\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.0;\n    host.appendChild(renderer.domElement);\n\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(27, 1, 0.1, 50);\n    camera.position.set(0, 4.3, 7.2);\n    camera.lookAt(0, 0.4, 0);\n\n    scene.add(new THREE.HemisphereLight(0xfff4e4, 0x9c8668, 1.1));\n    const key = new THREE.DirectionalLight(0xffffff, 2.1); key.position.set(-3, 6, 4); scene.add(key);\n    const fillL = new THREE.DirectionalLight(0xfff1de, 0.7); fillL.position.set(4, 2, 3); scene.add(fillL);\n    const rim = new THREE.DirectionalLight(0xffffff, 0.8); rim.position.set(0, 3, -5); scene.add(rim);\n\n    // Pillow shape: puffy center, sagging edge midpoints, crisp corners, soft wrinkles\n    const pinchX = (v) => 0.07 * (1 - v * v);\n    const pinchZ = (u) => 0.11 * (1 - u * u);\n    function height(u, v) {\n      const a = Math.max(0, (1 - u * u) * (1 - v * v));\n      let h = T * Math.pow(a, 0.32);\n      const crease = Math.sin(u * 10.5 + v * 4.2) * Math.sin(v * 8.3 - u * 2.7) + 0.6 * Math.sin((u - v) * 15);\n      h += 0.02 * crease * Math.pow(a, 0.25) * (1 - a);\n      return h;\n    }\n    function pointAt(u, v, sign, lift) {\n      return [u * W / 2 * (1 - pinchX(v)), sign * (height(u, v) + (lift || 0)), v * H / 2 * (1 - pinchZ(u))];\n    }\n    function faceGeometry(sign, N, M) {\n      const pos = [], uv = [], idx = [];\n      for (let j = 0; j <= M; j++) {\n        const v = -1 + 2 * j / M;\n        for (let i = 0; i <= N; i++) {\n          const u = -1 + 2 * i / N;\n          pos.push(...pointAt(u, v, sign));\n          uv.push((u + 1) / 2, (v + 1) / 2);\n        }\n      }\n      for (let j = 0; j < M; j++) for (let i = 0; i < N; i++) {\n        const a = j * (N + 1) + i, b = a + 1, c = a + N + 1, d = c + 1;\n        if (sign > 0) idx.push(a, c, b, b, c, d); else idx.push(a, b, c, b, d, c);\n      }\n      const g = new THREE.BufferGeometry();\n      g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\n      g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\n      g.setIndex(idx); g.computeVertexNormals();\n      return g;\n    }\n\n    // Woven cotton bump texture\n    function weaveTexture() {\n      const c = document.createElement('canvas'); c.width = c.height = 256;\n      const ctx = c.getContext('2d'); const img = ctx.createImageData(256, 256);\n      for (let y = 0; y < 256; y++) for (let x = 0; x < 256; x++) {\n        const weave = ((x >> 1) + (y >> 1)) % 2 ? 18 : -18;\n        const slub = Math.sin(y * 0.21) * 10 + Math.sin(x * 0.13 + y * 0.05) * 6;\n        const v = 128 + weave + slub + (Math.random() - 0.5) * 34;\n        const k = (y * 256 + x) * 4; img.data[k] = img.data[k + 1] = img.data[k + 2] = v; img.data[k + 3] = 255;\n      }\n      ctx.putImageData(img, 0, 0);\n      const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(14, 9);\n      return t;\n    }\n    const bump = weaveTexture();\n    const cloth = new THREE.MeshPhysicalMaterial({\n      color: fabric, roughness: 0.93, metalness: 0,\n      sheen: 0.8, sheenRoughness: 0.55, sheenColor: new THREE.Color('#fff4e2'),\n      bumpMap: bump, bumpScale: 0.6\n    });\n\n    const flip = new THREE.Group();\n    flip.add(new THREE.Mesh(faceGeometry(1, 120, 80), cloth));\n    flip.add(new THREE.Mesh(faceGeometry(-1, 120, 80), cloth));\n\n    // Piping along the seam\n    const seam = [];\n    const S = 60;\n    for (let i = 0; i < S; i++) seam.push(pointAt(-1 + 2 * i / S, -1, 1));\n    for (let i = 0; i < S; i++) seam.push(pointAt(1, -1 + 2 * i / S, 1));\n    for (let i = 0; i < S; i++) seam.push(pointAt(1 - 2 * i / S, 1, 1));\n    for (let i = 0; i < S; i++) seam.push(pointAt(-1, 1 - 2 * i / S, 1));\n    const curve = new THREE.CatmullRomCurve3(seam.map((p) => new THREE.Vector3(p[0], 0, p[2])), true, 'catmullrom', 0.1);\n    const pipeMat = cloth.clone(); pipeMat.color = fabric.clone().multiplyScalar(0.94); pipeMat.bumpMap = null;\n    flip.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 480, 0.03, 10, true), pipeMat));\n\n    // Sewn side labels that conform to the fabric\n    function labelTexture(text) {\n      const c = document.createElement('canvas'); c.width = 512; c.height = 150;\n      const ctx = c.getContext('2d');\n      ctx.fillStyle = root.dataset.labelBg || '#8B8E5A'; ctx.fillRect(0, 0, 512, 150);\n      ctx.strokeStyle = 'rgba(255,255,255,.35)'; ctx.setLineDash([6, 6]); ctx.lineWidth = 3; ctx.strokeRect(12, 12, 488, 126);\n      ctx.fillStyle = '#FBF6EC'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n      ctx.font = '600 54px \"DM Sans\", system-ui, sans-serif';\n      if ('letterSpacing' in ctx) ctx.letterSpacing = '10px';\n      ctx.fillText(String(text || '').toUpperCase(), 256, 78);\n      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 8;\n      return t;\n    }\n    function label(text, top) {\n      const lw = 0.36, lh = 0.105, N = 24, M = 6, zc = 0.5, pos = [], uv = [], idx = [];\n      for (let j = 0; j <= M; j++) for (let i = 0; i <= N; i++) {\n        const a = -1 + 2 * i / N, b = -1 + 2 * j / M;\n        const x = a * lw, zWorld = zc - b * lh;          // text reads upright toward the viewer\n        const z = top ? zWorld : -zWorld;                 // bottom face lands mirrored in z after the flip\n        let u = x / (W / 2), v = z / (H / 2);\n        v = v / (1 - pinchZ(u)); u = u / (1 - pinchX(v));\n        const y = (height(u, v) + 0.006) * (top ? 1 : -1);\n        pos.push(x, y, z); uv.push((a + 1) / 2, (b + 1) / 2);\n      }\n      for (let j = 0; j < M; j++) for (let i = 0; i < N; i++) {\n        const a = j * (N + 1) + i, b = a + 1, c = a + N + 1, d = c + 1; idx.push(a, b, c, b, d, c);\n      }\n      const g = new THREE.BufferGeometry();\n      g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\n      g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\n      g.setIndex(idx); g.computeVertexNormals();\n      const m = new THREE.MeshStandardMaterial({ map: labelTexture(text), roughness: 0.8, side: THREE.DoubleSide, polygonOffset: true, polygonOffsetFactor: -2 });\n      return new THREE.Mesh(g, m);\n    }\n    flip.add(label(root.dataset.woolLabel, true));\n    flip.add(label(root.dataset.latexLabel, false));\n\n    // Soft contact shadow\n    function blobTexture() {\n      const c = document.createElement('canvas'); c.width = c.height = 256;\n      const ctx = c.getContext('2d'); const g = ctx.createRadialGradient(128, 128, 10, 128, 128, 128);\n      g.addColorStop(0, 'rgba(60,44,28,0.55)'); g.addColorStop(0.55, 'rgba(60,44,28,0.25)'); g.addColorStop(1, 'rgba(60,44,28,0)');\n      ctx.fillStyle = g; ctx.fillRect(0, 0, 256, 256);\n      return new THREE.CanvasTexture(c);\n    }\n    const blob = new THREE.Mesh(new THREE.PlaneGeometry(W * 1.35, H * 1.55), new THREE.MeshBasicMaterial({ map: blobTexture(), transparent: true, depthWrite: false }));\n    blob.rotation.x = -Math.PI / 2; blob.position.y = -T - 0.01;\n\n    const lift = new THREE.Group(); lift.add(flip);\n    const yaw = new THREE.Group(); yaw.add(lift); yaw.add(blob);\n    scene.add(yaw);\n\n    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);\n    let state = root._pf || { t: 0, p: 0 }, queued = false;\n    function render() {\n      queued = false;\n      const t = state.t, p = state.p, up = Math.sin(Math.PI * t);\n      const angle = reduce ? (t >= 0.5 ? Math.PI : 0) : ease(t) * Math.PI;\n      flip.rotation.x = -angle;                                  // tumbles toward the viewer\n      lift.position.y = reduce ? 0 : up * 0.9;\n      yaw.rotation.y = -0.32 + p * 0.64;\n      blob.scale.set(1 - up * 0.22, 1, 0.55 + 0.45 * Math.abs(Math.cos(angle)));\n      blob.material.opacity = 1 - up * 0.55;\n      renderer.render(scene, camera);\n    }\n    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(render); } };\n    let lastW = 0, lastH = 0, resizeQueued = false;\n    function resize() {\n      resizeQueued = false;\n      const w = Math.round(host.clientWidth), h = Math.round(host.clientHeight);\n      if (!w || !h || (w === lastW && h === lastH)) return;\n      lastW = w; lastH = h;\n      renderer.setSize(w, h, false); camera.aspect = w / h;\n      camera.fov = w / h < 1.2 ? 33 : 27; camera.updateProjectionMatrix(); queue();\n    }\n    const queueResize = () => { if (!resizeQueued) { resizeQueued = true; requestAnimationFrame(resize); } };\n    root.addEventListener('pf:progress', (e) => { state = e.detail; queue(); });\n    new ResizeObserver(queueResize).observe(host);\n    resize(); render();\n    root.classList.add('pf-3d');\n  }\n</script>",
