        "collapsible_tab_wP3yAA": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How it feels",
            "icon": "none",
            "content": "<p>Naturally airy with an effortlessly relaxed feel. Linen's open weave promotes exceptional airflow, releasing heat and moisture for our coolest sleep experience. It begins with a crisp, breathable texture and develops an even softer, lived-in feel over time.</p>",
            "page": "",
            "margin_top": 40,
            "margin_bottom": 0,
            "margin_top_mobile": 32,
            "margin_bottom_mobile": 0
          }
        },
        "collapsible_tab_W7etYx": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Specifications",
            "icon": "none",
            "content": "<ul><li>Includes 1 flat sheet, 1 fitted sheet & 2 pillowcases*</li><li>Certified Organic Linen</li><li>Naturally Open Weave for Maximum Airflow</li><li>Exceptional Moisture Wicking</li><li>Fits Mattresses Up to 15\" Deep</li><li>Reinforced Elastic for a Secure Fit</li><li>Machine Washable</li><li>Handcrafted in the USA</li></ul><p>*Twin/Twin XL includes one pillowcase.</p>",
            "page": "",
            "margin_top": 0,
            "margin_bottom": 0,
            "margin_top_mobile": 0,
            "margin_bottom_mobile": 0
          }
        },
        "collapsible_tab_THr6Kx": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials",
            "icon": "none",
            "content": "<p><strong>Organic Linen</strong> — Woven from certified organic flax fibers, linen naturally allows more airflow than cotton while wicking away heat and moisture. Its breathable, textured weave creates a cooler, drier sleep surface and becomes softer and more relaxed with every wash. No synthetic blends, dyes, or chemical treatments.</p>",
            "page": "",
            "margin_top": 0,
            "margin_bottom": 0,
            "margin_top_mobile": 0,
            "margin_bottom_mobile": 0
          }
        },
        "collapsible_tab_4LJNQb": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Warranty & Returns",
            "icon": "check_mark",
            "content": "<p>Unopened sheet sets may be returned within 30 days of delivery. For hygiene reasons, opened, used, stained, or damaged bedding cannot be returned. If your sheets arrive with a manufacturing defect, we'll make it right through a replacement or refund.</p><p>Need help? Contact our customer support team to start a return or warranty claim. <a href=\"/pages/shipping-returns-policy\" title=\"Shipping & Returns Policy\"><span style=\"text-decoration:underline\">Start Here</span></a></p>",
            "page": "",
            "margin_top": 0,
            "margin_bottom": 0,
