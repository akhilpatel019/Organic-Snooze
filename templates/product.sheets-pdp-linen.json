    "nw_faq_VygLpj": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_hb8tnf": {
          "type": "faq_item",
          "settings": {
            "question": "Why choose linen?",
            "answer": "<p>Linen is naturally one of the most breathable bedding fabrics available. Its open weave allows heat and moisture to escape, creating exceptional airflow and a cooler, drier sleep environment. It also develops a softer, more relaxed feel with every wash while maintaining its signature breathability.</p>"
          }
        },
        "faq_item_rnJYwh": {
          "type": "faq_item",
          "settings": {
            "question": "Are these good if I sleep hot?",
            "answer": "<p>Yes. Linen is our coolest Breezeline fabric. Its naturally airy weave promotes maximum airflow and helps release heat instead of trapping it, making it an excellent choice for hot sleepers, warm climates, or anyone looking for a cooler night's sleep.</p>"
          }
        },
        "faq_item_rG8phx": {
          "type": "faq_item",
          "settings": {
            "question": "What's included and will it fit my bed?",
            "answer": "<p>Each set includes one fitted sheet, one flat sheet, and two pillowcases (Twin/Twin XL includes one pillowcase). The fitted sheet features reinforced elastic and fits mattresses up to 15\" deep.</p>"
          }
        },
        "faq_item_qwBaqn": {
          "type": "faq_item",
          "settings": {
            "question": "Do linen sheets feel rough?",
            "answer": "<p>Not at all. Linen has a naturally crisp, textured feel that's different from cotton—not rough, just more relaxed and breathable. It softens beautifully over time while maintaining the airflow and cooling benefits that make linen so popular.</p>"
          }
        },
        "faq_item_QbMgNb": {
          "type": "faq_item",
          "settings": {
            "question": "How do the three Breezeline sets differ?",
            "answer": "<p>Ultimate Snooze combines certified organic latex, organic wool, and pocket coils with zero toxic chemicals, glues, or fiberglass for restorative, clean sleep.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_hb8tnf",
        "faq_item_rnJYwh",
