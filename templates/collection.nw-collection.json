    "nw_faq_CfP8mf": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_pw6gT9": {
          "type": "faq_item",
          "settings": {
            "question": "What makes the Ultimate Snooze different from other organic mattresses?",
            "answer": "<p>Ultimate Snooze combines certified organic latex, organic wool, and pocket coils with zero toxic chemicals, glues, or fiberglass for restorative, clean sleep.</p>"
          }
        },
        "faq_item_9GEpDA": {
          "type": "faq_item",
          "settings": {
            "question": "What materials are used?",
            "answer": "<p>We use 100% GOLS certified organic latex, GOTS certified organic wool, and GOTS certified organic cotton with recycled steel pocket coils.</p>"
          }
        },
        "faq_item_RmCAXi": {
          "type": "faq_item",
          "settings": {
            "question": "Does it contain flame retardants or fiberglass?",
            "answer": "<p>No. We never use chemical flame retardants or fiberglass. We use natural organic wool as our flame barrier.</p>"
          }
        },
        "faq_item_3DPYpN": {
          "type": "faq_item",
          "settings": {
            "question": "Will I sleep hot?",
            "answer": "<p>Organic latex and wool are naturally temperature regulating and breathable, keeping you cool all night long.</p>"
          }
        },
        "faq_item_dijNXX": {
          "type": "faq_item",
          "settings": {
            "question": "What if I don’t like it?",
            "answer": "<p>We offer a 100-night risk-free trial. If it's not the right fit, you can return it hassle-free.</p>"
          }
        },
        "faq_item_gPzEDh": {
          "type": "faq_item",
          "settings": {
            "question": "Can I finance it or use HSA/FSA?",
            "answer": "<p>Yes, we offer financing through Affirm, ShopPay, and Acima, as well as TrueMed HSA/FSA eligibility at checkout.</p>"
          }
        }
      },
