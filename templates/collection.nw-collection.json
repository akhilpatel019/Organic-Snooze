    "nw_understand_mattress_Yat4zp": {
      "type": "nw-understand-mattress",
      "blocks": {
        "faq_item_iGBNx8": {
          "type": "faq_item",
          "settings": {
            "question": "What is an organic latex mattress?",
            "answer": "<p>Organic latex comes from the sap of rubber trees rather than petroleum-based foam. It naturally contours to your body, springs back when you move, and promotes airflow for cooler sleep. Unlike conventional memory foam, certified organic latex is exceptionally durable and retains its support for years.</p>",
            "open_by_default": true
          }
        },
        "faq_item_NeJr9k": {
          "type": "faq_item",
          "settings": {
            "question": "Why is wool used in an organic mattress?",
            "answer": "<p>Wool is one of nature's smartest performance materials. It naturally regulates temperature by wicking away moisture, helping you stay cooler in summer and warmer in winter. It also serves as a natural flame barrier, eliminating the need for chemical flame retardants found in many conventional mattresses.</p>",
            "open_by_default": false
          }
        },
        "faq_item_ykd3mQ": {
          "type": "faq_item",
          "settings": {
            "question": "Organic materials vs. synthetic materials&nbsp;",
            "answer": "<p>Conventional mattresses often rely on polyurethane foam, polyester fibers, fiberglass, and synthetic adhesives. We take a different approach, using certified organic cotton, wool, natural latex, and steel coils to create a cleaner, more breathable sleep environment. Every material is intentionally selected to support comfort, durability, and long-term performance.</p>",
            "open_by_default": false
          }
        }
      },
      "block_order": [
        "faq_item_iGBNx8",
        "faq_item_NeJr9k",
        "faq_item_ykd3mQ"
      ],
