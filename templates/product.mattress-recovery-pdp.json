          }
        },
        "collapsible_tab_THr6Kx": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Warranty",
            "icon": "none",
            "content": "<p>Backed by a 30-year warranty covering construction, structural integrity, and excessive sinking, non-prorated for years 1 to 20 and prorated for years 21 to 30. Every mattress also comes with a 100-night in-home trial and a 30-night break-in period, so you can decide on real sleep, not a first impression. A $199 pickup fee applies to returns in some cases.</p>",
            "page": "",
            "margin_top": 0,
