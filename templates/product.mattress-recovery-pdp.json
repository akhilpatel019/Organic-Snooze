        "collapsible_tab_W7etYx": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Specifications",
            "icon": "none",
            "content": "<ul><li>10\" depth, medium-firm feel (4/10 on the comfort scale)</li><li>Organic cotton cover, soft and breathable against skin<br/></li><li>Organic wool base layer, regulates heat and naturally flame-resistan 1\" natural GOLS latex, responsive comfort that won't sink like foam</li><li>800-count pocketed steel coil system with reinforced edge support</li><li>Hand-tufted construction, no glues or adhesives</li><li>Organic latex, wool, and cotton. No chemical foams, no VOC off-gassing, no synthetic fillers</li><li>Handcrafted in the USA</li></ul>",
            "page": "",
            "margin_top": 40,
