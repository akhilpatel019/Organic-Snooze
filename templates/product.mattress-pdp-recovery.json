    "nw_faq_VygLpj": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_hb8tnf": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between the Pure and the Recovery Mattress?",
            "answer": "<p>Both mattresses are handcrafted with certified organic materials and feature responsive organic latex, organic wool, organic cotton, and pocketed coils. The biggest differences are feel, comfort layer, and overall construction.</p><p><strong>Pure Organic Mattress</strong></p><ul><li><strong>Feel:</strong> Firm/Mdium</li><li><strong>Height:</strong> 10\"</li><li><strong>Comfort Layer:</strong> 1\" responsive organic latex</li><li><strong>Support Core:</strong> 800 pocketed coils</li><li><strong>Best For:</strong> Sleepers who prefer a firmer, more minimalist feel with straightforward support.</li></ul><p><strong>Ultimate Recovery Mattress</strong></p><ul><li><strong>Feel:</strong> Firm/Mdium/Soft</li><li><strong>Height:</strong> 13\"</li><li><strong>Comfort Layer:</strong> 4\" responsive organic latex Euro-top</li><li><strong>Support Core:</strong> 1,100 zoned pocketed coils</li><li><strong>Best For:</strong> Sleepers who want firm support with deeper pressure relief, enhanced contouring, and a more luxurious feel. This is the mattress Gary Brecka sleeps on and recommends.</li></ul>"
          }
        },
        "faq_item_rG8phx": {
          "type": "faq_item",
          "settings": {
            "question": "What's inside the Recovery mattress?",
            "answer": "<p>Organic cotton cover, organic wool base layer, 4\" Organic Latex, and 1,100 pocketed steel coil support system. Hand-tufted with no glue.</p>"
          }
        },
        "faq_item_qwBaqn": {
          "type": "faq_item",
          "settings": {
            "question": "Who is the Recovery mattress best for?",
            "answer": "<p>The Recovery Organic Mattress is ideal combination sleepers that like a firm support while also having a light contouring top layer.</p>"
          }
        },
        "faq_item_QbMgNb": {
          "type": "faq_item",
          "settings": {
            "question": "Does it off-gas or smell?",
            "answer": "<p>No. Ultimate Snooze combines certified organic latex, organic wool, and pocket coils with zero toxic chemicals, glues, or fiberglass for restorative, clean sleep.</p>"
          }
        },
        "faq_item_pV4KRW": {
          "type": "faq_item",
          "settings": {
            "question": "Can I try it risk-free?",
            "answer": "<p>Yes. The Ultimate Snooze Mattress comes with a 100-night sleep trial (with a 30-night break-in period) and a 30-year limited warranty. The return process does require a pick up fee of $199 in some cases.</p>"
          }
        },
        "faq_item_EkJ8ed": {
          "type": "faq_item",
          "settings": {
            "question": "Does it work with an adjustable base?",
            "answer": "<p>Yes. It is compatible with adjustable bases with proper support. We recommend our Snooze Lift adjustable base as a perfect pairing</p>"
          }
        },
        "faq_item_xqi3wi": {
