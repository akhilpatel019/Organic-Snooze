    "nw_faq_ccQzHN": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_W6AE8E": {
          "type": "faq_item",
          "settings": {
            "question": "What makes the Ultimate Snooze different from other organic mattresses?",
            "answer": "<p>Ultimate Snooze is built around cleaner materials, breathable comfort, and long-term recovery. Instead of polyurethane foam, fiberglass, or chemical flame retardants, our mattresses use certified organic cotton, organic wool, natural latex, and responsive pocketed coils.</p><h3></h3>"
          }
        },
        "faq_item_TWKXxN": {
          "type": "faq_item",
          "settings": {
            "question": "What materials are used?",
            "answer": "<p>Our mattresses are made with organic cotton, organic wool, natural latex, and individually pocketed steel coils. These materials are chosen for breathability, pressure relief, durability, and a cleaner sleep environment.</p><h3></h3>"
          }
        },
        "faq_item_pRjNWN": {
          "type": "faq_item",
          "settings": {
            "question": "Does it contain flame retardants or fiberglass?",
            "answer": "<p>No. Ultimate Snooze mattresses are made without fiberglass and without chemical flame retardants. We use organic wool as the natural fire barrier.</p><h3></h3>"
          }
        },
        "faq_item_WmWn74": {
          "type": "faq_item",
          "settings": {
            "question": "Will I sleep hot?",
            "answer": "<p>Ultimate Snooze is designed to sleep naturally breathable. Organic wool, cotton, latex, and pocketed coils help release heat and moisture instead of trapping it like many foam mattresses.</p><h3></h3>"
          }
        },
        "faq_item_CdMnT3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I don’t like it?",
            "answer": "<p>You have a 100-night comfort guarantee to try the mattress at home. If it is not the right fit, our team will help you through the return or exchange process based on the policy terms.</p><h3></h3>"
          }
        },
        "faq_item_rXHJG6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I finance it or use HSA/FSA?",
            "answer": "<p>Yes. Affirm financing is available at checkout, and eligible customers may be able to use HSA/FSA funds for qualifying purchases.</p>"
          }
        }
      },
