        "collapsible_tab_wP3yAA": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Why You'll Love It",
            "icon": "none",
            "content": "<ul><li><strong>1\" Organic Latex:</strong> Breathable comfort layer.</li><li><strong>800 Pocketed Coils:</strong> Support and motion control.&nbsp;</li><li><strong>Organic Wool:</strong> Keeps you cool, dry, and comfortable year-round.</li><li><strong>Hand-Tufted</strong>: No chemical glues. Built to last.</li><li><strong>Certified Organic Fill: </strong>Latex, Wool, and Cotton</li><li><strong>Made Without:</strong> Polyurethane, petroleum foam, fiberglass, or polyester.</li></ul>",
