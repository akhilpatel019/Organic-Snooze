        "show_verified": true,
        "role": "Longevity Expert & Co-Founder of The Ultimate Snooze",
        "show_footer_content": true,
        "footer_heading": "Be intentional about where you spend the most time.",
        "footer_description": "<p><strong>You spend nearly one-third of your life in bed. Choose materials you'll trust for every hour.</strong></p>",
