    "nw_recovery_v2_Human": {
      "type": "nw-recovery-v2",
      "name": "NW Recovery V2",
      "settings": {
        "heading": "The Sleep Environment Gary Brecka Built For Himself.",
        "quote": "<p>We spend nearly one-third of our lives in bed, yet most people never think about what they're sleeping on. That's why I helped create Ultimate Snooze using certified organic materials, because better recovery starts with a cleaner sleep environment.</p>",
        "name": "Gary Brecka",
        "role": "Longevity Expert & Co-Founder of The Ultimate Snooze",
        "role_mobile": "Longevity Expert & Co-Founder of The Ultimate Snooze",
        "show_verified": true,
        "show_custom_icon": true,
        "custom_icon": "shopify://shop_images/verified-v3.svg",
        "photo": "shopify://shop_images/718-DSC07303_1_2_1.png",
        "body_text": "<p><strong>Gary believes sleep is the foundation of recovery.</strong> It's when your body repairs muscle, regulates hormones, restores your nervous system, and prepares you for tomorrow. That's why every product in this collection is built with breathable natural materials designed to support deeper, healthier sleep.</p>",
        "heading_color": "#613916",
        "body_color": "#4e2f14",
        "card_text_color": "#ffffff",
        "quote_mark_color": "#878735",
        "verified_icon_color": "#878735",
