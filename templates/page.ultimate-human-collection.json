    "nw_faq_yTwkby": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_WGfmDX": {
          "type": "faq_item",
          "settings": {
            "question": "Why did Gary partner with Snooze Mattress Company?",
            "answer": "<p>Gary Brecka has spent decades studying how the body recovers and optimizing the environments that support it. When searching for a mattress built with certified organic materials instead of conventional synthetic foams, he found very few options available. That search led to a partnership with Matt Smith and Snooze Mattress Company to develop a collection centered around cleaner materials and recovery-focused design.</p>"
          }
        },
        "faq_item_nC87iE": {
          "type": "faq_item",
          "settings": {
            "question": "Why does Gary believe mattress materials matter?",
            "answer": "<p>Gary believes the sleep environment is one of the most overlooked aspects of recovery. Since people spend nearly one-third of their lives in bed, the materials they're surrounded by every night should be carefully considered—not just for comfort, but for breathability and overall sleep quality.</p>"
          }
        },
        "faq_item_iWNDG8": {
          "type": "faq_item",
          "settings": {
            "question": "How firm is the Pillow Top vs. the Pure?",
